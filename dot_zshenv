# Disable /etc/zshrc_Apple_Terminal
SHELL_SESSIONS_DISABLE=1

# Load local env exports (JIRA / Slack / GCloud / Claude tokens) in ALL shells,
# including non-interactive ones such as the Claude Code Bash tool.
# Single source of truth: ~/.bash/conf/0_env_local.sh (sourced here so it is no
# longer limited to interactive zsh via ~/.zshrc -> ~/.zsh/conf -> bash conf).
[ -f ~/.bash/conf/0_env_local.sh ] && . ~/.bash/conf/0_env_local.sh

# Load PATH in ALL zsh invocations, including non-interactive ones such as the
# Claude Code Bash tool (which reads .zshenv but NOT .zshrc). Shared POSIX source
# of truth: ~/.bash/conf/0_path.sh (bash reads the same file via ~/.bashenv).
# Needs GCLOUD_MY_HOME from 0_env_local.sh above, so source it after that.
[ -f ~/.bash/conf/0_path.sh ] && . ~/.bash/conf/0_path.sh
typeset -U path PATH   # de-duplicate; .zshrc re-sources 0_path.sh interactively
